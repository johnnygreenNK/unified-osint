# ============================================================================
# UnifiedOSINT - przykladowa konfiguracja. Skopiuj do .env i wypelnij.
# NIGDY nie commituj pliku .env z prawdziwymi wartosciami.
# ============================================================================

# --- Srodowisko ---
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres (lokalny, w Docker Compose) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=unified_osint
POSTGRES_USER=osint_app
# Haslo wylacznie backendowe (nigdy nie trafia do frontendu). Wygeneruj wlasne,
# np.: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://osint_app:change-me-strong-password@postgres:5432/unified_osint

# --- Auth (wlasny, bez Supabase) ---
# Sekret do podpisywania JWT dostepowych. Min. 32 bajty losowe.
# Wygeneruj: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-64-hex-chars-00000000000000000000000000000000
JWT_REFRESH_SECRET=replace-with-64-hex-chars-11111111111111111111111111111111
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Koszt argon2id (pamiec w KiB) - podnies na mocniejszym serwerze
AUTH_ARGON2_MEMORY_KB=19456

# --- Tryb jednego konta ---
# Gdy w bazie nie ma zadnego uzytkownika, API tworzy automatycznie jedno konto
# z rola 'admin' o ponizszych danych. Frontend loguje sie na nie bez formularza
# (POST /auth/auto-login) - dziala tylko, gdy w systemie jest dokladnie jedno
# konto. Jesli pojawi sie drugie konto (reczna rejestracja), auto-logowanie
# samo sie wylacza i pokazuje sie normalny formularz logowania.
DEFAULT_USER_EMAIL=local@unified-osint.local
DEFAULT_USER_DISPLAY_NAME=Operator

# --- API (Fastify) ---
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Worker / kolejka (pg-boss na tym samym Postgresie) ---
WORKER_CONCURRENCY=5
WORKER_PG_SCHEMA=pgboss

# --- Limity i budzet (wartosci domyslne, nadpisywalne per uzytkownik w DB) ---
MAX_SOURCES_PER_SEARCH=8
MAX_CONCURRENT_SEARCHES_PER_USER=2
# Budzet dla szybkich adapterow HTTP (demo/dns/snusbase/...). Adaptery CLI
# (klonowanie repo, skanowanie, OSINT narzedzia) uzywaja CLI_ADAPTER_TIMEOUT_MS.
DEFAULT_ADAPTER_TIMEOUT_MS=15000
# Budzet dla adapterow opartych na lokalnych narzedziach CLI (patrz sekcja
# nizej) - np. TruffleHog potrzebuje ~60-90s na pelny klon historii git.
CLI_ADAPTER_TIMEOUT_MS=120000
GLOBAL_SEARCH_BUDGET_PER_DAY=200

# --- Adaptery bez klucza: wlaczone domyslnie ---
# RDAP: https://rdap.org/ (RFC 7480/7481/9082/9083, limit 10 zad./10s)
# crt.sh: https://crt.sh/ (nieoficjalne, ale powszechnie uzywane API Certificate Transparency)
# Wayback CDX: https://github.com/internetarchive/wayback/blob/master/wayback-cdx-server/README.md
# Shodan InternetDB: https://blog.shodan.io/introducing-the-internetdb-api/ (darmowe TYLKO niekomercyjnie)
ADAPTER_DEMO_ENABLED=false
ADAPTER_DNS_ENABLED=true
ADAPTER_RDAP_ENABLED=true
ADAPTER_CRTSH_ENABLED=true
ADAPTER_WAYBACK_ENABLED=true
ADAPTER_SHODAN_INTERNETDB_ENABLED=true

# --- Snusbase (platne, breach-data: email/username -> gdzie wyciekl) ---
# Status adaptera bez klucza: not_configured. Zrodlo: https://beta.snusbase.com/
SNUSBASE_API_KEY=
SNUSBASE_API_BASE_URL=https://api.snusbase.com

# --- Epieos (platne, OSINT po e-mailu - oficjalne API) ---
EPIEOS_API_KEY=
EPIEOS_API_BASE_URL=https://api.epieos.com

# --- IntelX (platne/freemium, status do weryfikacji w dokumentacji) ---
INTELX_API_KEY=
INTELX_API_BASE_URL=https://2.intelx.io

# --- HIBP / Have I Been Pwned (platne, breach + paste po e-mailu - oficjalne API v3) ---
# Zrodlo: https://haveibeenpwned.com/API/v3
HIBP_API_KEY=
HIBP_API_BASE_URL=https://haveibeenpwned.com/api/v3
# Wymagany przez API (bez tego naglowka zapytanie zwraca 403) - nazwa Twojej aplikacji, nie sekret.
HIBP_USER_AGENT=UnifiedOSINT

# --- LeakCheck.io (platne, breach-data po email/username/phone - API Pro v2) ---
# Zrodlo: https://docs.leakcheck.io/
LEAKCHECK_API_KEY=
LEAKCHECK_API_BASE_URL=https://leakcheck.io/api/v2

# --- Hudson Rock / Cavalier (platne, infostealer intelligence po email/username) ---
# Zrodlo: https://docs.hudsonrock.com/ (wymaga uprawnienia 'search-by-login')
HUDSONROCK_API_KEY=
HUDSONROCK_API_BASE_URL=https://api.hudsonrock.com

# --- EmailRep.io (reputacja e-mail) ---
# Zrodlo: https://docs.sublime.security/reference/emailrep-introduction
# UWAGA: Sublime Security NIE WYDAJE juz nowych kluczy EmailRep (serwis
# wygaszony/nie jest aktywnie rozwijany) - dziala tylko dla kluczy wydanych
# wczesniej. Bez klucza adapter zostaje w stanie not_configured.
EMAILREP_API_KEY=
EMAILREP_USER_AGENT=UnifiedOSINT

# --- Zaslepki not_configured: brak publicznego self-serve API (sprzedaz B2B/
# enterprise albo dokumentacja dostepna tylko po zalogowaniu) - patrz README.md.
DEHASHED_API_KEY=
SPYCLOUD_API_KEY=
FLARE_API_KEY=
KELA_API_KEY=
CONSTELLA_API_KEY=

# --- Adaptery CLI (dzialaja natywnie na tej maszynie, bez Dockera) ---
# Status bez wskazanej/zainstalowanej binarki: not_configured. Sciezka moze
# byc nazwa z PATH (np. "amass") albo absolutna. Wymaga recznej instalacji
# kazdego narzedzia (go install / pip install / ...) - patrz docs/.
GITLEAKS_BIN_PATH=gitleaks
GIT_BIN_PATH=git
AMASS_BIN_PATH=amass
TRUFFLEHOG_BIN_PATH=trufflehog
SHERLOCK_BIN_PATH=sherlock
MAIGRET_BIN_PATH=maigret
# Holehe sonduje przeplywy "zapomnialem hasla" ~150 serwisow, aby sprawdzic
# czy e-mail ma tam konto - swiadomie bez ograniczania funkcjonalnosci
# (decyzja uzytkownika), mimo ryzyka ToS/wzorca naduzycia. Uzywaj tylko do
# autoryzowanego OSINT.
HOLEHE_BIN_PATH=holehe
THEHARVESTER_BIN_PATH=theHarvester

# --- Inne integracje opcjonalne (pozostaw puste = not_configured) ---
HUNTER_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
GITHUB_TOKEN=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32-chars
TELEGRAM_WEBHOOK_URL=https://your-domain.example/telegram/webhook

# --- SSRF / siec wychodzaca adapterow ---
OUTBOUND_HTTP_ALLOW_PRIVATE_NETWORKS=false
OUTBOUND_HTTP_TIMEOUT_MS=10000
